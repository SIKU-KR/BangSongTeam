{
  "name": "prj-ppt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "imports": {
    "#shared": "./src/shared/index.ts",
    "#db": "./src/db/index.ts",
    "#components/*": "./src/client/components/*.tsx",
    "#lib/*": "./src/client/lib/*.ts",
    "#hooks/*": "./src/client/hooks/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@hono/zod-validator": "^0.4.3",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "es-hangul": "^2.4.0",
    "hono": "^4.7.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "nanoid": "^5.1.16",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-moveable": "^0.56.0",
    "react-router-dom": "^7.18.4",
    "tinykeys": "^4.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-pool-workers": "0.12.19",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.21.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.5.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.135.0"
  }
}
