{
  "name": "bangsongteam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "imports": {
    "#shared": "./src/shared/index.ts",
    "#db": "./src/db/index.ts",
    "#components/*": "./src/client/components/*.tsx",
    "#lib/*": "./src/client/lib/*.ts",
    "#hooks/*": "./src/client/hooks/*.ts",
    "#copy/*": "./src/client/copy/*.ts"
  },
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build && node scripts/buildServiceWorker.mjs",
    "start": "next start -p 5173",
    "emulators": "node scripts/emulators.mjs",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:local": "node scripts/seedLocal.mjs",
    "fonts:previews": "node scripts/buildFontPreviews.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/google-sans": "^5.3.1",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@google-cloud/firestore": "^9.4.0",
    "@google-cloud/storage": "^8.4.0",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "es-hangul": "^2.4.0",
    "hono": "^4.13.11",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "nanoid": "^5.1.16",
    "next": "16.4.3",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-moveable": "^0.56.0",
    "sonner": "^2.0.8",
    "tinykeys": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.34.1",
    "globals": "^16.0.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.5.3",
    "react-grab": "^0.2.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
