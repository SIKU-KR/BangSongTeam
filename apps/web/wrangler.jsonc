{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prj-ppt-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  // SPA 폴백: /presentations, /editor/:id, /present/:id/fullscreen 같은 클라이언트
  // 경로를 직접 열거나 새로고침해도 index.html 이 서빙되도록 한다.
  // run_worker_first 로 /api/* 만 Worker 가 먼저 처리한다 (그 외는 정적 자산 우선).
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prj-ppt-db",
      "database_id": "99ce1495-f402-4983-9012-6f86150c8537",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "prj-ppt-media"
    }
  ]
}
