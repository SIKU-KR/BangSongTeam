{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangsongteam",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  // 운영 오류 추적용 Workers Logs. console.error가 대시보드에 남는다.
  "observability": {
    "enabled": true
  },
  // Worker 번들은 압축해서 올린다(vite.config.ts). 소스맵을 함께 올려야 로그의
  // 스택 트레이스가 원래 파일·줄 번호로 보인다.
  "upload_source_maps": true,
  // 운영 주소는 custom domain 하나뿐이다. workers.dev를 끄는 이유: 출처가 둘이면
  // PWA 캐시·IndexedDB·로그인 쿠키가 둘로 갈린다. 로컬 개발은 .dev.vars(.env)의
  // BETTER_AUTH_URL이 아래 값을 덮는다.
  "routes": [
    { "pattern": "bangsongteam.siku-labs.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "vars": {
    "BETTER_AUTH_URL": "https://bangsongteam.siku-labs.com"
  },
  // SPA 폴백: /presentations, /editor/:id, /present/:id/fullscreen 같은 클라이언트
  // 경로를 직접 열거나 새로고침해도 index.html 이 서빙되도록 한다.
  // run_worker_first 로 /api/* 만 Worker 가 먼저 처리한다 (그 외는 정적 자산 우선).
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bangsongteam-db",
      "database_id": "bf29bc4d-6b91-472b-ba68-063bc99902e9",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "bangsongteam-media"
    }
  ]
}
