{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangsongteam",
  // `opennextjs-cloudflare build`가 Next.js 빌드를 Worker로 묶은 진입점
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 운영 오류 추적용 Workers Logs. console.error가 대시보드에 남는다.
  "observability": {
    "enabled": true
  },
  // 소스맵을 함께 올려야 로그의 스택 트레이스가 원래 파일·줄 번호로 보인다.
  "upload_source_maps": true,
  // 운영 주소는 custom domain 하나뿐이다. workers.dev를 끄는 이유: 출처가 둘이면
  // PWA 캐시·IndexedDB·로그인 쿠키가 둘로 갈린다. 로컬 개발은 .dev.vars(.env)의
  // BETTER_AUTH_URL이 아래 값을 덮는다.
  "routes": [
    { "pattern": "bangsongteam.siku-labs.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "vars": {
    "BETTER_AUTH_URL": "https://bangsongteam.siku-labs.com"
  },
  // 정적 자산(`/_next/static`, `public/`)은 자산 핸들러가 먼저 서빙하고, 나머지 페이지와
  // /api/*는 Next.js Worker가 처리한다.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bangsongteam-db-v2",
      "database_id": "5a48a9a7-6b5a-4914-89ac-1b7da45e8d4b",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "bangsongteam-media"
    }
  ],
  // 배경 벡터 검색. 둘 다 로컬 시뮬레이션이 없어 원격으로만 동작한다. `pnpm dev`는
  // CF_REMOTE_BINDINGS=true일 때만 붙고, 이때 인덱스는 `next.config.ts`가 로컬용으로 바꾼다.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "BACKGROUND_INDEX",
      "index_name": "bangsongteam-backgrounds-gemma",
      "remote": true
    }
  ]
}
