{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prj-ppt-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  // 운영 오류 추적용 Workers Logs. console.error가 대시보드에 남는다.
  "observability": {
    "enabled": true
  },
  // 운영 도메인을 사기 전까지 workers.dev 주소를 쓴다. 도메인을 옮기는 절차는
  // docs/ops/deploy-runbook.md. 로컬 개발은 .dev.vars(.env)의 값이 이것을 덮는다.
  "vars": {
    "BETTER_AUTH_URL": "https://prj-ppt-web.peter012677.workers.dev"
  },
  // SPA 폴백: /presentations, /editor/:id, /present/:id/fullscreen 같은 클라이언트
  // 경로를 직접 열거나 새로고침해도 index.html 이 서빙되도록 한다.
  // run_worker_first 로 /api/* 만 Worker 가 먼저 처리한다 (그 외는 정적 자산 우선).
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prj-ppt-db",
      "database_id": "da46eb99-d8aa-4229-bbaa-8a6f5d0a6557",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "prj-ppt-media"
    }
  ]
}
