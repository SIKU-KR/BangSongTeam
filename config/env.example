# Better Auth Settings
BETTER_AUTH_SECRET=local-development-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:5173

# Firestore·미디어 (로컬)
#
# `pnpm emulators`로 띄운 Firestore 에뮬레이터와 `.data/media` 폴더를 쓴다. 운영(Cloud Run)은
# 서비스 계정으로 Firestore에 붙고 MEDIA_BUCKET(GCS 버킷)에서 배경을 읽는다.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=demo-bangsongteam
MEDIA_DIR=.data/media
# 로컬에서는 GCE 메타데이터 서버를 찾지 않는다 (자격 증명 탐색 경고를 없앤다)
METADATA_SERVER_DETECTION=none

# OAuth Providers
#
# 카카오·네이버 개발자 콘솔, Google Cloud Console(OAuth 클라이언트 ID, 웹 애플리케이션)에서
# 앱을 등록하고 채운다.
# Redirect URI: https://<도메인>/api/auth/callback/kakao , .../naver , .../google
# 비워 두면 해당 프로바이더는 등록되지 않고 로그인 화면에도 나오지 않는다.
# 로컬에서 로그인하려면 하나 이상 채운다. 구글은 Redirect URI에 localhost를 허용한다
# (http://localhost:5173/api/auth/callback/google).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
