# Better Auth Settings
BETTER_AUTH_SECRET=local-development-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:5173

# OAuth Providers
#
# 카카오·네이버 개발자 콘솔, Google Cloud Console(OAuth 클라이언트 ID, 웹 애플리케이션)에서
# 앱을 등록하고 채운다.
# Redirect URI: https://<도메인>/api/auth/callback/kakao , .../naver , .../google
# 비워 두면 해당 프로바이더는 등록되지 않고 로그인 화면에도 나오지 않는다.
# 로컬에서 로그인하려면 하나 이상 채운다. 구글은 Redirect URI에 localhost를 허용한다
# (http://localhost:5173/api/auth/callback/google).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
